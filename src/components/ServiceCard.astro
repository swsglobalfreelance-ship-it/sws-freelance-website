---
import type { CollectionEntry } from "astro:content";
import Card from "./ui/Card.astro";
import Icon from "./ui/Icon.astro";

interface Props {
  service: CollectionEntry<"services">;
}
const { service } = Astro.props;
const { title, shortDescription, icon, category, slug } = service.data;
---

<Card href={`/services/${category}/${slug}/`} class="group h-full">
  <div class="flex h-12 w-12 items-center justify-center rounded-md bg-brand-50 text-brand-700">
    <Icon name={icon as any} class="size-6" />
  </div>
  <h3 class="mt-5 text-lg font-bold text-ink-900 group-hover:text-brand-700">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-ink-500">{shortDescription}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">
    Learn more
    <Icon name="arrow-right" class="size-4" />
  </span>
</Card>
