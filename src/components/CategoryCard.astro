---
import type { CollectionEntry } from "astro:content";
import Card from "./ui/Card.astro";
import Icon from "./ui/Icon.astro";

interface Props {
  category: CollectionEntry<"categories">;
  serviceCount?: number;
}
const { category, serviceCount } = Astro.props;
const { title, description, icon, slug } = category.data;
---

<Card href={`/services/${slug}/`} class="group h-full">
  <div class="flex h-12 w-12 items-center justify-center rounded-md bg-brand-50 text-brand-700">
    <Icon name={icon as any} class="size-6" />
  </div>
  <h3 class="mt-5 text-lg font-bold text-ink-900 group-hover:text-brand-700">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-ink-500">{description}</p>
  <div class="mt-4 flex items-center justify-between text-sm">
    {serviceCount !== undefined && (
      <span class="text-ink-400">{serviceCount} service{serviceCount === 1 ? "" : "s"}</span>
    )}
    <span class="inline-flex items-center gap-1 font-semibold text-brand-700">
      View services
      <Icon name="arrow-right" class="size-4" />
    </span>
  </div>
</Card>
