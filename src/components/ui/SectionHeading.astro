---
// Consistent "eyebrow + heading + optional subtitle" block used to open
// nearly every section on the site.
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  as?: "h1" | "h2" | "h3";
}
const { eyebrow, title, subtitle, align = "center", as: Tag = "h2" } = Astro.props;
---

<div data-reveal class:list={["max-w-2xl", align === "center" ? "mx-auto text-center" : "text-left"]}>
  {eyebrow && (
    <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-brand-600">
      {eyebrow}
    </p>
  )}
  <Tag class="text-3xl sm:text-4xl font-bold tracking-tight text-ink-900">
    {title}
  </Tag>
  {subtitle && (
    <p class="mt-4 text-lg leading-relaxed text-ink-500">
      {subtitle}
    </p>
  )}
</div>
