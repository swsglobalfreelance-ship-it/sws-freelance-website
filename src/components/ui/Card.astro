---
// Base card shell reused by ServiceCard, PortfolioCard, and any future
// card-style content — keeps border/radius/shadow/padding consistent.
export interface Props {
  class?: string;
  as?: keyof HTMLElementTagNameMap;
  href?: string;
}
const { class: className = "", as: Tag = "div", href } = Astro.props;
const FinalTag = href ? "a" : Tag;
---

<FinalTag
  href={href}
  class:list={[
    "block rounded-lg border border-ink-100 bg-white p-6 shadow-soft transition-all duration-150",
    href ? "hover:shadow-soft-lg hover:-translate-y-0.5 hover:border-brand-200" : "",
    className,
  ]}
>
  <slot />
</FinalTag>
