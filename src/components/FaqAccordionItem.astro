---
// Native <details>/<summary> accordion — accessible and keyboard-operable
// with zero JavaScript.
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Icon from "./ui/Icon.astro";

interface Props {
  faq: CollectionEntry<"faqs">;
}
const { faq } = Astro.props;
const { Content } = await render(faq);
---

<details class="group border-b border-ink-100 py-5">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink-900 marker:content-none">
    {faq.data.question}
    <Icon name="chevron-down" class="size-5 shrink-0 text-ink-400 transition-transform group-open:rotate-180" />
  </summary>
  <div class="mt-3 max-w-3xl text-sm leading-relaxed text-ink-500">
    <Content />
  </div>
</details>
