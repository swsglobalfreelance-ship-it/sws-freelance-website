---
import { getCollection } from "astro:content";
import { siteConfig } from "../data/site";
import Container from "./ui/Container.astro";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";

const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));

// Nav is data-driven: a new category or service appears in this dropdown
// automatically — nothing here needs to change when one is added.
const categories = (await getCollection("categories")).sort((a, b) => a.data.order - b.data.order);
const allServices = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const servicesByCategory = categories.map((category) => ({
  category,
  services: allServices.filter((s) => s.data.category === category.data.slug),
}));

const otherNavItems = siteConfig.nav.filter((item) => item.href !== "/" && item.href !== "/services/");
---

<header id="site-header" class="sticky top-0 z-40 border-b border-ink-100 bg-white/90 backdrop-blur transition-shadow duration-200">
  <Container class="flex h-16 items-center justify-between sm:h-20">
    <a href="/" class="flex items-center gap-2 font-heading text-lg font-bold text-ink-900 sm:text-xl">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-md bg-brand-700 text-sm font-bold text-white"
        aria-hidden="true"
      >
        {siteConfig.brandShortName.slice(0, 1)}
      </span>
      {siteConfig.brandName}
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 lg:flex">
      <a
        href="/"
        class:list={[
          "rounded-md px-3.5 py-2 text-sm font-medium transition-colors",
          isActive("/") ? "text-brand-700" : "text-ink-600 hover:text-brand-700",
        ]}
        aria-current={isActive("/") ? "page" : undefined}
      >
        Home
      </a>

      <!-- Services: hover/focus dropdown, entirely generated from the
           categories + services collections. -->
      <div class="group relative">
        <a
          href="/services/"
          class:list={[
            "flex items-center gap-1 rounded-md px-3.5 py-2 text-sm font-medium transition-colors",
            isActive("/services/") ? "text-brand-700" : "text-ink-600 hover:text-brand-700",
          ]}
          aria-current={isActive("/services/") ? "page" : undefined}
          aria-haspopup="true"
        >
          Services
          <Icon name="chevron-down" class="size-3.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" />
        </a>

        <div
          class="invisible absolute left-1/2 top-full z-50 w-[36rem] -translate-x-1/2 translate-y-1 opacity-0 transition-all duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
        >
          <div class="mt-2 grid grid-cols-2 gap-6 rounded-lg border border-ink-100 bg-white p-6 shadow-soft-lg">
            {servicesByCategory.map(({ category, services }) => (
              <div>
                <a
                  href={`/services/${category.data.slug}/`}
                  class="flex items-center gap-2 text-sm font-bold text-ink-900 hover:text-brand-700"
                >
                  <Icon name={category.data.icon as any} class="size-4 text-brand-600" />
                  {category.data.title}
                </a>
                <ul class="mt-3 space-y-2">
                  {services.map((service) => (
                    <li>
                      <a
                        href={`/services/${category.data.slug}/${service.data.slug}/`}
                        class="text-sm text-ink-500 hover:text-brand-700"
                      >
                        {service.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>

      {otherNavItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "rounded-md px-3.5 py-2 text-sm font-medium transition-colors",
            isActive(item.href) ? "text-brand-700" : "text-ink-600 hover:text-brand-700",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:block">
      <Button href={siteConfig.ctaHref} size="md">
        {siteConfig.ctaLabel}
        <Icon name="arrow-right" class="size-4" />
      </Button>
    </div>

    <button
      id="mobile-menu-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-md text-ink-700 hover:bg-ink-100 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <Icon name="menu" class="size-6" id="menu-icon-open" />
      <Icon name="x" class="hidden size-6" id="menu-icon-close" />
    </button>
  </Container>

  <nav id="mobile-menu" aria-label="Mobile" class="hidden border-t border-ink-100 bg-white lg:hidden">
    <Container class="flex flex-col gap-1 py-4">
      <a
        href="/"
        class:list={["rounded-md px-3 py-2.5 text-base font-medium", isActive("/") ? "bg-brand-50 text-brand-700" : "text-ink-700 hover:bg-ink-50"]}
      >
        Home
      </a>

      <details class="group/services">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-md px-3 py-2.5 text-base font-medium text-ink-700 hover:bg-ink-50 marker:content-none">
          <a href="/services/" class="flex-1">Services</a>
          <Icon name="chevron-down" class="size-4 shrink-0 transition-transform group-open/services:rotate-180" />
        </summary>
        <div class="pb-2 pl-3">
          {servicesByCategory.map(({ category, services }) => (
            <div class="mt-2">
              <a href={`/services/${category.data.slug}/`} class="block px-3 py-1.5 text-sm font-bold text-ink-800">
                {category.data.title}
              </a>
              {services.map((service) => (
                <a
                  href={`/services/${category.data.slug}/${service.data.slug}/`}
                  class="block px-3 py-1.5 text-sm text-ink-500"
                >
                  {service.data.title}
                </a>
              ))}
            </div>
          ))}
        </div>
      </details>

      {otherNavItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "rounded-md px-3 py-2.5 text-base font-medium",
            isActive(item.href) ? "bg-brand-50 text-brand-700" : "text-ink-700 hover:bg-ink-50",
          ]}
        >
          {item.label}
        </a>
      ))}
      <Button href={siteConfig.ctaHref} size="md" class="mt-2 w-full">
        {siteConfig.ctaLabel}
      </Button>
    </Container>
  </nav>
</header>

<script>
  // Minimal vanilla JS — no framework/library needed for a single toggle.
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-icon-open");
  const closeIcon = document.getElementById("menu-icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("hidden") === false;
    menu?.classList.toggle("hidden");
    openIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
  });

  // Subtle shadow once the page scrolls — a small depth cue, not a layout change.
  const header = document.getElementById("site-header");
  const applyScrollState = () => header?.classList.toggle("is-scrolled", window.scrollY > 4);
  applyScrollState();
  window.addEventListener("scroll", applyScrollState, { passive: true });
</script>
