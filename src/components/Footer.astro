---
import { siteConfig } from "../data/site";
import { getCollection } from "astro:content";
import Container from "./ui/Container.astro";

const categories = (await getCollection("categories")).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-100 bg-ink-950 text-ink-300">
  <Container class="grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4 lg:py-16">
    <div class="lg:col-span-1">
      <p class="font-heading text-lg font-bold text-white">{siteConfig.brandName}</p>
      <p class="mt-3 text-sm leading-relaxed text-ink-400">{siteConfig.tagline}</p>
    </div>

    <div>
      <p class="text-sm font-semibold text-white">Services</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {categories.map((category) => (
          <li>
            <a href={`/services/${category.data.slug}/`} class="text-ink-400 hover:text-white">
              {category.data.title}
            </a>
          </li>
        ))}
        <li>
          <a href="/services/" class="text-ink-400 hover:text-white">All Services</a>
        </li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-white">Company</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {siteConfig.nav
          .filter((item) => item.href !== "/")
          .map((item) => (
            <li>
              <a href={item.href} class="text-ink-400 hover:text-white">{item.label}</a>
            </li>
          ))}
        <li>
          <a href="/contact/" class="text-ink-400 hover:text-white">Contact</a>
        </li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-white">Legal</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {siteConfig.legalNav.map((item) => (
          <li>
            <a href={item.href} class="text-ink-400 hover:text-white">{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </Container>

  <div class="border-t border-white/10">
    <Container class="flex flex-col gap-2 py-6 text-xs text-ink-500 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {siteConfig.brandName}. All rights reserved.</p>
      <p>An independent freelance services business.</p>
    </Container>
  </div>
</footer>
