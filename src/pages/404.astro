---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Page Not Found" description="This page could not be found." noindex>
  <Container class="flex flex-col items-center py-28 text-center sm:py-36">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">404</p>
    <h1 class="mt-3 text-3xl font-bold text-ink-900 sm:text-4xl">Page not found</h1>
    <p class="mt-4 max-w-md text-ink-500">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <div class="mt-8 flex gap-4">
      <Button href="/">Back to Home</Button>
      <Button href="/services/" variant="secondary">Browse Services</Button>
    </div>
  </Container>
</BaseLayout>
