---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import { siteConfig } from "../../data/site";

const lastUpdated = "Draft — not yet published";
---

<BaseLayout title="Terms of Service" description={`Terms of service for ${siteConfig.brandName}.`}>
  <Container class="max-w-3xl py-16 sm:py-20">
    <h1 class="text-3xl font-bold text-ink-900">Terms of Service</h1>
    <p class="mt-2 text-sm text-ink-400">{lastUpdated}</p>

    <p class="mt-6 rounded-lg border border-dashed border-ink-300 bg-ink-50 p-5 text-sm leading-relaxed text-ink-600">
      <strong class="text-ink-800">Starter template — review before launch.</strong>
      This is a plain-language starting point, not legal advice. Have it
      reviewed — ideally by a legal professional — before publishing, and
      fill in the bracketed specifics (revision policy, payment terms,
      jurisdiction) to match how the business actually operates.
    </p>

    <div class="mt-10 space-y-8 leading-relaxed text-ink-600">
      <section>
        <h2 class="text-lg font-bold text-ink-900">Services</h2>
        <p class="mt-2">
          {siteConfig.brandName} provides the services described on this site
          (Amazon e-commerce services, and data entry / virtual assistant
          services). Exact scope, price, and timeline for a project are
          confirmed with the client before work begins.
        </p>
      </section>
      <section>
        <h2 class="text-lg font-bold text-ink-900">Client-provided content</h2>
        <p class="mt-2">
          For services involving product information or images, the client
          confirms they have the right to share and use that content. We
          represent the product accurately based on what's provided — we do
          not alter a product's real identity, components, or specifications.
        </p>
      </section>
      <section>
        <h2 class="text-lg font-bold text-ink-900">Revisions</h2>
        <p class="mt-2">
          [Define the revision policy per project type — e.g. number of
          included revision rounds — before publishing this page.]
        </p>
      </section>
      <section>
        <h2 class="text-lg font-bold text-ink-900">Payment</h2>
        <p class="mt-2">
          [Define payment terms — timing, method, deposits — before
          publishing this page.]
        </p>
      </section>
      <section>
        <h2 class="text-lg font-bold text-ink-900">Contact</h2>
        <p class="mt-2">
          Questions about these terms can be sent to {siteConfig.contactEmail}.
        </p>
      </section>
    </div>
  </Container>
</BaseLayout>
